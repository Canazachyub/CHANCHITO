# Copiar a .env.local (no se sube a git) y completar con los valores reales.
# Vite solo expone al cliente las variables prefijadas con VITE_.

# URL del Web App de Apps Script publicado (termina en /exec).
VITE_API_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# Token compartido (CONTRACT § 3 "Autenticación de cada request"). Mismo valor que
# SHARED_TOKEN en PropertiesService del backend. No es secreto de verdad (viaja en la URL,
# visible en devtools) — es un filtro básico contra bots, no reemplaza la sesión de Google.
VITE_SHARED_TOKEN=

# OAuth Client ID de Google Identity Services (CONTRACT § 0.1). Mismo valor que
# GOOGLE_CLIENT_ID en PropertiesService del backend.
VITE_GOOGLE_CLIENT_ID=

# DSN de Sentry para capturar errores de JS no manejados en el frontend (README § 11).
# Si se deja vacío, main.tsx no inicializa Sentry (ver el `if (dsn)` ahí).
VITE_SENTRY_DSN=

# Modo demo local (solo dev): siembra data de ejemplo y una sesion falsa para ver
# la app sin backend ni OAuth configurado. Nunca se activa en build de produccion.
VITE_DEMO=false
